# ==============================================================================
# FairShare Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Supabase PostgreSQL & Storage Credentials
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-operations

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Security Settings
MAX_CONTENT_LENGTH=10485760 # 10 MB limit in bytes
UPLOAD_BUCKET=evidence_files
